# Firebase Web App Configuration (optional for local-only mode; required for cloud fallback, Remote Config, App Check, and encrypted sync)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Firebase App Check (required by #BuildHybridAI 2026)
# For local development and judge evaluation, register a debug token in the Firebase Console
# (App Check -> Apps -> Manage debug tokens) and paste it below.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=
VITE_FIREBASE_RECAPTCHA_SITE_KEY=

# Optional Chrome Extension OAuth Client ID for Google Sign-In (optional sync only)
VITE_GOOGLE_OAUTH_CLIENT_ID=

# Optional Uninstall Survey URL (hosted on Firebase Hosting; receives only the optional user survey answer)
VITE_UNINSTALL_SURVEY_URL=https://your-project.web.app/uninstall.html
