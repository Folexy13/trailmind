{
  "name": "trailmind",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Your browsing, remembered. On your device. Privacy-first Chrome extension built on Firebase AI Logic hybrid inference.",
  "license": "MIT",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build && npm run build:content && npm run copy:manifest",
    "build:content": "vite build --config vite.content.config.ts",
    "copy:manifest": "node scripts/build-manifest.mjs",
    "package": "npm run build && node scripts/package-zip.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts eval",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"eval/**/*.{ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,html}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"eval/**/*.{ts,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "eval": "tsx eval/run-eval.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@mozilla/readability": "^0.6.0",
    "chrono-node": "^2.10.3",
    "dexie": "^4.4.7",
    "diff-match-patch": "^1.0.5",
    "dompurify": "^3.4.18",
    "firebase": "^13.4.0",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "jszip": "^3.10.2",
    "lucide-react": "^1.77.0",
    "minisearch": "^7.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sigma": "^4.0.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/chrome": "^0.3.7",
    "@types/diff-match-patch": "^1.0.36",
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "fake-indexeddb": "^6.2.8",
    "globals": "^16.0.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
